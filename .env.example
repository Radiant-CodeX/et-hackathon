# Copy to .env and fill in. NEVER commit the real .env.

# --- Toggle ---
# true  = AI calls return canned responses (no Azure key needed; great for dev)
# false = real Azure AI Foundry calls
USE_STUBS=true

# --- Azure AI Foundry (model provider; LangChain is the framework) ---
AZURE_INFERENCE_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_INFERENCE_KEY=your-key-here
AZURE_DEPLOYMENT_NAME=gpt-4o
AZURE_API_VERSION=2024-10-21
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Neo4j (compose sets these automatically; override for local runs) ---
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
